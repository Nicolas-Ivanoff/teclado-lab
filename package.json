{
  "name": "teclado-lab",
  "version": "0.0.1",
  "description": "Versao minima do e-commerce para investigar o comportamento do teclado no iOS",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 5210 --configuration=development",
    "build": "ng build --configuration=development",
    "build:production": "ng build --configuration=production",
    "preparar:ios": "node scripts/preparar-ios.js",
    "buildSynciOS": "ng build --configuration=development && node scripts/preparar-ios.js && node scripts/configure-ios-info-plist.js && npx cap copy ios && npx cap sync ios && npx cap open ios"
  },
  "engines": {
    "node": "22.13.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/angular": "^8.0.0",
    "@maskito/angular": "^4.0.1",
    "@maskito/core": "^4.0.1",
    "ionicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@capacitor/cli": "^8.0.0",
    "@ionic/angular-toolkit": "^12.0.0",
    "plist": "^3.1.0",
    "typescript": "~5.6.3"
  }
}
